<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bagas Febriyanto — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FAF8F3;
    --paper-shade:#F1EDE3;
    --ink:#1C2B39;
    --ink-soft:#51606C;
    --accent:#2F6F5E;
    --accent-warm:#B8763B;
    --rule:#DBD5C6;
    --max:760px;
  }

  *{ box-sizing:border-box; }

  html{ scroll-behavior:smooth; }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    *{ animation:none !important; transition:none !important; }
  }

  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    font-size:16px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }

  a{ color:var(--accent); text-decoration-thickness:1px; text-underline-offset:3px; }
  a:hover{ color:var(--accent-warm); }
  a:focus-visible, button:focus-visible{ outline:2px solid var(--accent-warm); outline-offset:3px; }

  .wrap{ max-width:var(--max); margin:0 auto; padding:0 24px; }

  /* Nav */
  nav{
    position:sticky; top:0; z-index:10;
    background:rgba(250,248,243,0.92);
    backdrop-filter:saturate(140%) blur(6px);
    border-bottom:1px solid var(--rule);
  }
  nav .wrap{
    display:flex; align-items:center; justify-content:space-between;
    padding-top:16px; padding-bottom:16px;
  }
  nav .name{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:1.05rem;
    letter-spacing:0.01em;
  }
  nav .links{ display:flex; gap:22px; }
  nav .links a{
    color:var(--ink-soft);
    text-decoration:none;
    font-size:0.92rem;
  }
  nav .links a:hover{ color:var(--accent); }

  @media (max-width:560px){
    nav .wrap{ flex-wrap:wrap; row-gap:10px; padding-top:14px; padding-bottom:14px; }
    nav .name{ font-size:0.98rem; }
    nav .links{ gap:12px; width:100%; }
    nav .links a{ font-size:0.8rem; }
  }

  /* Hero */
  header.hero{ padding:76px 0 56px; }
  .hero h1{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:clamp(2.1rem, 5vw, 3.1rem);
    line-height:1.12;
    margin:0 0 22px;
    max-width:14ch;
    opacity:0;
    animation:rise 700ms ease-out 80ms forwards;
  }
  .hero p.lede{
    max-width:56ch;
    color:var(--ink-soft);
    font-size:1.08rem;
    margin:0 0 30px;
    opacity:0;
    animation:rise 700ms ease-out 220ms forwards;
  }
  @keyframes rise{
    from{ opacity:0; transform:translateY(10px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .contact-line{
    display:flex; flex-wrap:wrap; gap:6px 14px;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.85rem;
    color:var(--ink-soft);
    margin-bottom:40px;
  }
  .contact-line a{ color:var(--ink-soft); }
  .contact-line a:hover{ color:var(--accent); }

  .stat-row{
    display:flex; flex-wrap:wrap;
    border-top:1px solid var(--rule);
  }
  .stat{
    flex:1 1 160px;
    padding:16px 18px 16px 0;
    border-bottom:1px solid var(--rule);
  }
  .stat .num{
    font-family:'IBM Plex Mono', monospace;
    font-size:1.5rem;
    color:var(--accent-warm);
    display:block;
  }
  .stat .label{
    font-size:0.85rem;
    color:var(--ink-soft);
  }

  /* Sections */
  section{ padding:52px 0; border-top:1px solid var(--rule); }
  section h2{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:1.5rem;
    margin:0 0 24px;
  }
  section .kicker{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.78rem;
    color:var(--ink-soft);
    margin-bottom:6px;
    display:block;
  }

  .about p{ max-width:64ch; margin:0 0 16px; }

  /* Experience */
  .job-head{
    display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline;
    gap:6px 16px; margin-bottom:6px;
  }
  .job-title{ font-weight:600; font-size:1.05rem; }
  .job-org{ color:var(--ink-soft); margin:0 0 20px; }
  .job-date{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.82rem;
    color:var(--ink-soft);
    white-space:nowrap;
  }

  .ledger{ border-top:1px solid var(--rule); margin:20px 0 22px; }
  .ledger-row{
    display:flex; gap:18px; align-items:baseline;
    padding:14px 0; border-bottom:1px solid var(--rule);
  }
  .ledger-row .figure{
    font-family:'IBM Plex Mono', monospace;
    font-size:1.05rem;
    color:var(--accent);
    flex:0 0 74px;
  }
  .ledger-row .desc{ color:var(--ink-soft); font-size:0.96rem; }

  .job-notes{ margin:0; padding-left:20px; color:var(--ink-soft); }
  .job-notes li{ margin-bottom:8px; }

  /* Leadership */
  .role{
    display:flex; flex-wrap:wrap; justify-content:space-between; gap:4px 16px;
    padding:16px 0; border-bottom:1px solid var(--rule);
  }
  .role:first-child{ border-top:1px solid var(--rule); }
  .role-main{ max-width:56ch; }
  .role-title{ font-weight:600; }
  .role-org{ color:var(--ink-soft); font-size:0.94rem; }
  .role-date{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.82rem;
    color:var(--ink-soft);
    white-space:nowrap;
  }

  /* Education / training table */
  .edu-item{ margin-bottom:26px; }
  .edu-item .job-title{ margin-bottom:2px; }

  table.training{
    width:100%; border-collapse:collapse;
    font-size:0.92rem;
    margin-top:6px;
  }
  table.training th{
    text-align:left;
    font-family:'IBM Plex Mono', monospace;
    font-weight:500;
    font-size:0.76rem;
    color:var(--ink-soft);
    padding:8px 10px 8px 0;
    border-bottom:1px solid var(--ink);
  }
  table.training td{
    padding:10px 10px 10px 0;
    border-bottom:1px solid var(--rule);
    vertical-align:top;
  }
  table.training td.score{
    font-family:'IBM Plex Mono', monospace;
    color:var(--accent-warm);
    white-space:nowrap;
  }
  table.training td.hours{
    font-family:'IBM Plex Mono', monospace;
    color:var(--ink-soft);
    white-space:nowrap;
  }

  /* Skills */
  .skills p{ max-width:66ch; color:var(--ink-soft); }
  .skills strong{ color:var(--ink); font-weight:600; }

  /* Contact */
  .contact-block{
    display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:24px;
  }
  .contact-block p{ max-width:44ch; color:var(--ink-soft); margin:0; }
  .btn{
    display:inline-block;
    background:var(--ink);
    color:var(--paper);
    font-family:'IBM Plex Mono', monospace;
    font-size:0.88rem;
    padding:12px 20px;
    text-decoration:none;
    white-space:nowrap;
  }
  .btn:hover{ background:var(--accent); color:var(--paper); }

  footer{
    padding:28px 0 40px;
    color:var(--ink-soft);
    font-size:0.82rem;
    border-top:1px solid var(--rule);
  }

  @media (max-width:560px){
    header.hero{ padding:52px 0 40px; }
    section{ padding:40px 0; }
    .ledger-row{ gap:12px; }
    .ledger-row .figure{ flex-basis:58px; font-size:0.95rem; }
  }
</style>
</head>
